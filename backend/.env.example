###############################################################################
# T-World Module Service — backend environment template
#
# Copy this file to `.env` and fill in the values you need:
#   cp .env.example .env
#
# Every value below has a safe default for local development, so the API boots
# without any real credentials. Nothing in this file is a real secret.
###############################################################################

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Comma separated list of allowed origins, or * for any origin (dev only).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Requests per window, per IP. Set to 0 to disable rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The service uses multi-document transactions, so the database MUST be a
# replica set. A standalone `mongod` (no --replSet) cannot start the service.
MONGODB_URI=mongodb://127.0.0.1:27017/t-world?replicaSet=rs0
#   Local single-node replica set:
#     mongod --replSet rs0 --dbpath /path/to/data
#     mongosh --eval "rs.initiate()"
#   No MongoDB installed? From the repository root run `npm run db:memory`.
#   It starts an in-memory replica set on a random port and prints the exact
#   URI to paste here.
#   MongoDB Atlas: use the connection string it provides, e.g.
#     MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/t-world
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Authentication (development only)
# ---------------------------------------------------------------------------
# The assessment uses a trusted identity header instead of real auth.
# Set to `true` in shared/dev environments to enforce AUTH_DEV_ENABLED=true
# and the dev-only guard below, which refuses non-loopback callers.
AUTH_DEV_ENABLED=true
AUTH_DEV_ALLOWED_IPS=127.0.0.1,::1

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# mock | openai  (see src/ai/providers)
AI_PROVIDER=mock
AI_PROMPT_VERSION=v1
AI_TIMEOUT_MS=5000
# Tokens charged for requesting a summary. Refunded in full if the run fails
# or times out, so a user is never charged for a summary they did not receive.
# Set to 0 to make summaries free.
AI_REQUEST_COST=1
AI_SUCCESS_REWARD=5
# Simulated provider latency/failure knobs — mock provider only.
AI_MOCK_MIN_LATENCY_MS=250
AI_MOCK_MAX_LATENCY_MS=900
AI_MOCK_FAILURE_RATE=0
# Include the returned text when a run fails (timeout/error).
AI_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# Token economy
# ---------------------------------------------------------------------------
TOKEN_INITIAL_BALANCE=0
# Tokens awarded on each successful AI run. Overridden by AI_SUCCESS_REWARD.
TOKEN_AI_REWARD=5
# Tokens granted by `npm run seed` so the demo flows are usable immediately.
SEED_USER_TOKEN_BALANCE=100
# --- Exchange rates (tokens -> mock on-chain asset) ---
RATE_TOKENS_PER_MOCK_USDT=100
RATE_TOKENS_PER_MOCK_ETH=20000

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Staging provider for uploads: mock | cloudinary
MEDIA_UPLOAD_PROVIDER=mock
# Permanent provider used when a media item is promoted: mock | s3
MEDIA_PROMOTION_PROVIDER=mock
MEDIA_MAX_FILE_SIZE_BYTES=10485760

# Cloudinary (only needed when MEDIA_UPLOAD_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=t-world-media

# AWS S3 (only needed when MEDIA_PROMOTION_PROVIDER=s3)
AWS_REGION=eu-west-2
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Mock Web3 contract
# ---------------------------------------------------------------------------
WEB3_NETWORK_NAME=Ethereum
WEB3_CONTRACT_ADDRESS=0x1111111111111111111111111111111111111111
WEB3_CHAIN_ID=1
WEB3_MOCK_TX_PREFIX=0x
